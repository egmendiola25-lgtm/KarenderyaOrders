@model KarenderyaOrders.Models.Order

<h1>Create Order</h1>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="OrderNumber" class="form-label">Order Number</label>
        <input asp-for="OrderNumber" class="form-control" required />
    </div>

        <div class="mb-3">
        <label class="form-label">Food Item</label>
        <select name="FoodItemId" class="form-select" required>
            <option value="">-- Select Food Item --</option>
            @foreach (var food in ViewBag.FoodItems)
            {
                <option value="@food.Id">@food.Name - ₱@food.Price.ToString("N2")</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Quantity</label>
        <input type="number" name="Quantity" class="form-control" min="1" value="1" required />
    </div>

    <button type="submit" class="btn btn-primary">Save Order</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

