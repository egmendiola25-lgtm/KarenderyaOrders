@model KarenderyaOrders.Models.Order

<h1>Order Details</h1>

<div class="mb-3">
    <strong>Order Number:</strong> @Model.OrderNumber
</div>

<div class="mb-3">
    <strong>Date Created:</strong>
    @Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
</div>

<h3>Ordered Items</h3>

<table class="table">
    <thead>
        <tr>
            <th>Food Item</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.FoodItem?.Name</td>
                <td>@item.Quantity</td>
                <td>₱@item.UnitPrice.ToString("N2")</td>
                <td>₱@item.Subtotal.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>

<h4>Total Amount: ₱@Model.TotalAmount.ToString("N2")</h4>

<a asp-action="Index" class="btn btn-secondary">Back to Orders</a>