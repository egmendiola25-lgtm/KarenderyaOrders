@model IEnumerable<KarenderyaOrders.Models.FoodItem>

<h1>Food Items</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Food Item</a>
</p>

<p>Here are the food items available in your karenderya.</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Food Name</th>
            <th>Price</th>
            <th>Stock Quantity</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price.ToString("N2")</td>
                <td>@item.StockQuantity</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">Edit</a>

                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>


            </tr>
        }
    </tbody>
</table>
